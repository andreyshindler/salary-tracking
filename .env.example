# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to use this bot.
# Send /start to the bot and check the log to find your own ID.
ALLOWED_USER_IDS=123456789

# Where the SQLite file lives
DB_PATH=data/salary.db

# Logging
LOG_LEVEL=INFO

# --- Mini App (optional) ---
# Public HTTPS address the Telegram client will load the calendar from.
# Telegram refuses http:// and self-signed certificates, so this needs a real
# domain behind a reverse proxy. Leave it empty to keep the inline calendar.
WEBAPP_URL=
# Where the container listens for the reverse proxy to forward to.
WEBAPP_PORT=8080
