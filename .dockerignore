# Keep the build context small, and keep secrets and live data out of the image.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache

# Never bake these into a layer
.env
data/
backups/
*.db
*.db-wal
*.db-shm

# Not needed at runtime
tests/
deploy/
Dockerfile
docker-compose.yml
.dockerignore
